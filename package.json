  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@hono/node-server": "^2.1.5",
    "expo": "~58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "hono": "^4.13.14",
    "idb-keyval": "^6.3.0",
    "lucide-react-native": "^1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --host lan",
    "web": "expo start --web --host lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write src server scripts plugins app.json package.json tsconfig.json",
    "lint": "expo lint",
    "release:check": "node scripts/release-info.mjs --check",
    "build:apk": "bash scripts/build-apk.sh"
  },
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
