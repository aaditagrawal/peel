{
  "expo": {
    "name": "Peel",
    "slug": "peel-stickers",
    "version": "1.1.0-rc.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.peel.stickers",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "app.peel.stickers",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F7F2"
      },
      "versionCode": 10
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-document-picker",
      "./plugins/with-whatsapp",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose original photos and GIFs to make your stickers.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-release-signing"
    ],
    "scheme": "peel"
  }
}
